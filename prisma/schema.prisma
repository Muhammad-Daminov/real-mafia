generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Replay guard for Telegram `initData` (Master TZ §22.2, v5.0 §29.3).
///
/// Only the initData `hash` is stored — never the raw initData payload, which
/// the spec forbids persisting. Rows are self-expiring via `expiresAt`, which is
/// set to the end of the same freshness window the HMAC check enforces.
///
/// This is the PostgreSQL fallback path; Redis is the primary store (§34).
model TelegramInitDataReplay {
  hash      String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  username   String?
  firstName  String
  lastName   String?
  avatar     String?

  gamesPlayed Int     @default(0)
  gamesWon    Int     @default(0)
  level       Int     @default(1)
  xp          Int     @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
