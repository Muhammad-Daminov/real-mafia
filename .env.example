DATABASE_URL=
JWT_SECRET=
BOT_TOKEN=
REDIS_URL=

# Comma-separated list of exact allowed frontend origins (scheme+host+port,
# no path, no trailing slash, no wildcard). Shared by the HTTP API's CORS
# config and the /game Socket.IO gateway's own cors option
# (src/common/config/cors.ts). Unset defaults to http://localhost:5173 only.
CORS_ORIGINS=

# Optional. Unset (default) = no trusted proxy hops (see src/main.ts).
TRUST_PROXY_HOPS=

# Optional. Set to "api" on a replica that must not run the scheduled-task
# worker loop (src/common/scheduling/scheduler.service.ts).
PROCESS_ROLE=

# Optional. Defaults to 3000.
PORT=

# DEV/TEST ONLY. Set to exactly "true" to enable POST
# /dev/rooms/:code/fill-bots (src/dev-tools). WARNING: must NEVER be "true"
# (or set at all) when NODE_ENV=production — the app refuses to boot if it
# is (src/dev-tools/dev-tools.config.ts). Leave unset in every deployed env.
DEV_TOOLS_ENABLED=
