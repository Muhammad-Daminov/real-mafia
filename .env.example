# Required in every environment, including Render. Validated at boot
# (src/common/config/env-validation.ts) — the process refuses to start
# (logging only which VARIABLE is missing/invalid, never any value) if
# any of these four are unset, or if JWT_SECRET is shorter than 32
# characters.
DATABASE_URL=
JWT_SECRET=
BOT_TOKEN=

# Required on Render: must be exactly "production". Gates the
# DEV_TOOLS_ENABLED safety check below (src/dev-tools/dev-tools.config.ts)
# and is read directly by a handful of other "are we in prod" checks.
# Render does not set this for you — add it explicitly in the service's
# Environment tab.
NODE_ENV=

# Required in every environment (B-H1/OD-063) — the boot-time validator
# above refuses to start without it. `telegram-replay-guard.service.ts`
# still degrades to a PostgreSQL-backed fallback if Redis becomes
# unreachable AFTER boot (that runtime behavior is unchanged); this
# variable just makes "never configure Redis at all" no longer a silently
# accepted option.
REDIS_URL=

# Required in production (validated at boot, same mechanism as above) —
# the deployed frontend's exact origin (scheme+host, no path, no trailing
# slash, no wildcard — a literal "*" fails boot in production) — e.g.
# https://your-mini-app.example.com. Comma-separate multiple origins.
# Shared by the HTTP API's CORS config and the /game Socket.IO gateway's
# own cors option (src/common/config/cors.ts). Unset defaults to
# http://localhost:5173 only, which is wrong for any deployed environment.
CORS_ORIGINS=

# Required on Render: the platform sits in front of every request as a
# reverse proxy, so this must be at least 1 for per-IP rate limiting
# (§6.3, src/main.ts) to see the real client IP instead of Render's own
# edge. Unset (default) = no trusted proxy hops, correct only for a
# directly-exposed process (e.g. local dev).
TRUST_PROXY_HOPS=

# Optional. Set to "api" on a replica that must not run the scheduled-task
# worker loop (src/common/scheduling/scheduler.service.ts). Leave unset
# for a single-service Render deploy (the one process does both).
PROCESS_ROLE=

# Do not set on Render — the platform injects this itself, and src/main.ts
# already falls back to 3000 locally when unset.
PORT=

# DEV/TEST ONLY. Set to exactly "true" to enable POST
# /dev/rooms/:code/fill-bots (src/dev-tools). WARNING: must NEVER be "true"
# (or set at all) when NODE_ENV=production — the app refuses to boot if it
# is (src/dev-tools/dev-tools.config.ts). Leave unset on Render.
DEV_TOOLS_ENABLED=

# Required for the Telegram bot's /start webhook (src/telegram) to accept
# anything at all — POST /telegram/webhook requires this exact value on
# the X-Telegram-Bot-Api-Secret-Token header (constant-time compared) and
# REFUSES EVERY REQUEST (401) if this is left unset, rather than accepting
# unauthenticated webhook traffic. Generate a long random value, e.g.
# `openssl rand -hex 32`. Also read by `pnpm run telegram:set-webhook`.
TELEGRAM_WEBHOOK_SECRET=placeholder-generate-a-long-random-secret

# Required for the Telegram bot's /start reply (src/telegram) to include
# a working "O'ynash" button — the Mini App's own public HTTPS origin,
# e.g. https://your-mini-app.example.com (no trailing slash). The /start
# reply is skipped (logged, not sent) if this is unset.
MINI_APP_URL=https://your-mini-app.example.com

# Used only by `pnpm run telegram:set-webhook`/`telegram:webhook-info`
# (scripts/telegram-set-webhook.ts) — this backend's own public HTTPS
# origin, e.g. https://api.example.com (no trailing slash). Not read by
# the running app itself, only by the one-shot setup script.
PUBLIC_API_URL=https://your-api.example.com

# B-H1: optional, all default to the values shown if unset.
#
# POST /auth/telegram (per IP) — src/auth/auth.constants.ts.
AUTH_TELEGRAM_RATE_LIMIT=10
AUTH_TELEGRAM_RATE_LIMIT_TTL_MS=60000
#
# Command endpoints — create/join/ready/start/night-action/vote, per
# authenticated user (src/common/config/throttler.ts). In-memory,
# single-instance only — see OPEN_DECISIONS.md OD-064.
COMMAND_RATE_LIMIT=60
COMMAND_RATE_LIMIT_TTL_MS=60000
#
# Max concurrent /game Socket.IO connections per user
# (src/common/realtime/realtime.gateway.ts). In-memory, single-instance
# only — see OPEN_DECISIONS.md OD-064.
SOCKET_MAX_CONNECTIONS_PER_USER=5

# Stale-lobby cleanup (src/rooms/stale-lobby-cleanup.service.ts) — cancels
# rooms/games still in LOBBY with no join activity for this many minutes.
# Never touches RUNNING games. Both optional, defaults shown.
STALE_LOBBY_THRESHOLD_MINUTES=120
STALE_LOBBY_CLEANUP_INTERVAL_MINUTES=5
